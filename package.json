{
  "name": "forja",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,studio -c blue,magenta \"npm:dev:server\" \"npm:dev:studio\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:studio": "vite --config studio/vite.config.ts",
    "build": "vite build --config studio/vite.config.ts",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "db:migrate": "tsx --env-file-if-exists=.env server/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env server/db/cli.ts seed",
    "db:seed:dev": "tsx --env-file-if-exists=.env server/db/cli.ts seed:dev",
    "db:reset": "tsx --env-file-if-exists=.env server/db/cli.ts reset",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run test/unit",
    "test:e2e": "node test/e2e.mjs",
    "test:agents": "node test/agents.mjs",
    "test:github": "node test/github.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.13",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "clsx": "^2.1.1",
    "croner": "^11.0.0",
    "esbuild": "^0.28.2",
    "hono": "^4.13.14",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "playwright-core": "1.64.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "typescript": "^7.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
