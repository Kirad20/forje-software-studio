# Variables de arranque de Forja. Sirve para `npm run dev` y para Docker Compose local.
# En Coolify no copies este archivo: las variables se editan en la pestaña «Environment Variables»
# (ver docs/despliegue-coolify.md). Vacío = valor por defecto.
#
# Todo lo demás (registro de cuentas, créditos, proveedores y modelos, SMTP, Stripe, GitHub,
# Langfuse, evals, npm…) vive en la base de datos y se edita en el studio: Administración.
# Para no tener que meterlo a mano tras cada `npm run db:reset`, copia seed.local.example.json a
# seed.local.json (no se sube a git) y pon ahí tus claves.

# --- Solo Docker Compose (docker-compose.yml) ---
# En Coolify las genera él; en local ponlas tú.
# Origen público del studio (Coolify: el dominio que le asignes).
SERVICE_URL_FORJA_4100=http://localhost:4100
# Clave de cifrado de 64 hex: openssl rand -hex 32  (Coolify la genera y la conserva)
SERVICE_HEX_64_SECRETSKEY=
# Contraseña del servicio postgres del compose
SERVICE_PASSWORD_POSTGRES=
# Token interno compartido por forja y app-runtime; genera uno aleatorio y no lo reutilices
SERVICE_PASSWORD_APP_DATA=
SERVICE_PASSWORD_BUILDER=
# Token de la primera cuenta de administrador (vacío: se genera uno y sale en el log)
SERVICE_PASSWORD_BOOTSTRAP=
# Dominio raíz de las apps publicadas (<slug>.FORJA_DOMAIN), el host de PUBLIC_URL sin esquema.
FORJA_DOMAIN=
# 0 construye la imagen sin Chromium (sin browser_test)
# FORJA_BROWSER=1

# --- Base de datos de la plataforma (Postgres) ---
# Local con Docker: docker compose -f docker-compose.yml -f docker-compose.local.yml up postgres
DATABASE_URL=postgres://forja:forja@localhost:5432/forja

# Puerto del servidor de la plataforma (studio, API, apps, MCP)
PORT=4100
# Origen público; las apps publicadas viven en <slug>.localhost:PORT
PUBLIC_URL=http://localhost:4100
# Bases de datos de las apps (PGlite), archivos subidos y caché
DATA_DIR=./data
# Clave para cifrar los secretos (de los proyectos y de la configuración: claves de modelos, SMTP…).
# 32 bytes hex. Si se pierde o cambia, hay que volver a introducir esos secretos. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_KEY=
# Proxies inversos delante (Traefik en Coolify = 1). 0 si Forja está expuesta directamente:
# entonces X-Forwarded-For lo controla el cliente y no se usa.
FORJA_TRUST_PROXY=0

# Primera instalación: token de un solo uso para crear el administrador (mín. 16 caracteres).
# Vacío: se genera uno y se imprime en el log del servidor.
FORJA_BOOTSTRAP_TOKEN=

# Archivo de semillas (ajustes, proveedores, modelos). Por defecto ./seed.local.json si existe.
# FORJA_SEED_FILE=

# Chrome/Chromium para browser_test en lugar del de Playwright:
#   npx playwright-core install chromium-headless-shell
# FORJA_CHROMIUM=C:/Program Files/Google/Chrome/Application/chrome.exe
