# Puerto del servidor de la plataforma (studio, API, apps, MCP)
PORT=4100
# Origen público; las apps publicadas viven en <slug>.localhost:PORT
PUBLIC_URL=http://localhost:4100
# Dónde se guardan bases de datos, archivos y caché
DATA_DIR=./data
# Clave para cifrar los secretos de los proyectos (32 bytes hex). Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_KEY=

# --- Modelos ---
# El constructor es un equipo de agentes (planificador, datos, backend, interfaz, revisión).
# Un enrutador elige el modelo de cada agente entre los disponibles y permitidos, según la tarea,
# el modo del proyecto (Ahorro/Equilibrado/Calidad) y lo que ha aprendido de resultados anteriores.
# Proveedores: activa los que quieras; cada uno añade sus modelos al catálogo.
ANTHROPIC_API_KEY=
# OpenRouter: catálogo sincronizado a diario (precios, contexto, herramientas, visión)
OPENROUTER_API_KEY=
# Cualquier API compatible con OpenAI (OpenAI, Ollama, vLLM...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Más proveedores compatibles: [{"id":"local","baseUrl":"http://host:11434/v1","apiKeyEnv":"LOCAL_KEY"}]
FORJA_PROVIDERS=
# Modelos propios: [{"provider":"openai","model":"qwen3.8:latest","label":"Qwen 3.8","tier":3,"inPrice":0,"outPrice":0}]
FORJA_MODELS=
# Lista blanca de la plataforma (globs separados por comas). Vacío = valores por defecto
# (Sonnet 5.5, Haiku 5.5, compatibles OpenAI, familias selectas de OpenRouter). Cada cuenta y
# cada proyecto pueden restringirla más desde el studio.
FORJA_MODELS_ALLOW=
# Créditos por dólar de coste real del modelo
CREDITS_PER_USD=1000
# Compatibilidad: modelo fijo anterior (se añade al catálogo si no es de Anthropic)
BUILDER_MODEL=
APP_AI_MODEL=
# Créditos iniciales por cuenta
FREE_CREDITS=3000

# --- Correo (opcional). Sin SMTP, los correos solo quedan en el registro del proyecto ---
SMTP_URL=
EMAIL_FROM=noreply@forja.local

# --- Pagos (opcional) ---
STRIPE_SECRET_KEY=
