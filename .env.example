# Puerto del servidor de la plataforma (studio, API, apps, MCP)
PORT=4100
# Origen público; las apps publicadas viven en <slug>.localhost:PORT
PUBLIC_URL=http://localhost:4100
# Dónde se guardan bases de datos, archivos y caché
DATA_DIR=./data
# Clave para cifrar los secretos de los proyectos (32 bytes hex). Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_KEY=

# --- Modelos ---
# El constructor es un equipo de agentes (planificador, datos, backend, interfaz, revisión).
# Un enrutador elige el modelo de cada agente entre los disponibles y permitidos, según la tarea,
# el modo del proyecto (Ahorro/Equilibrado/Calidad) y lo que ha aprendido de resultados anteriores.
# Proveedores: activa los que quieras; cada uno añade sus modelos al catálogo.
ANTHROPIC_API_KEY=
# OpenRouter: catálogo sincronizado a diario (precios, contexto, herramientas, visión)
OPENROUTER_API_KEY=
# Cualquier API compatible con OpenAI (OpenAI, Ollama, vLLM...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Más proveedores compatibles: [{"id":"local","baseUrl":"http://host:11434/v1","apiKeyEnv":"LOCAL_KEY"}]
FORJA_PROVIDERS=
# Modelos propios: [{"provider":"openai","model":"qwen3.8:latest","label":"Qwen 3.8","tier":3,"inPrice":0,"outPrice":0}]
FORJA_MODELS=
# Lista blanca de la plataforma (globs separados por comas). Vacío = valores por defecto
# (Sonnet 5.5, Haiku 5.5, compatibles OpenAI, familias selectas de OpenRouter). Cada cuenta y
# cada proyecto pueden restringirla más desde el studio.
FORJA_MODELS_ALLOW=
# Créditos por dólar de coste real del modelo
CREDITS_PER_USD=1000
# Compatibilidad: modelo fijo anterior (se añade al catálogo si no es de Anthropic)
BUILDER_MODEL=
APP_AI_MODEL=
# Créditos iniciales por cuenta
FREE_CREDITS=3000

# --- Observabilidad de agentes (opcional): Langfuse, en la nube o autoalojado ---
# Con las dos claves, cada ejecución de agente se envía como traza (pasos del modelo con tokens,
# coste y latencia; herramientas con duración y error). No se envían prompts, código ni salidas.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Por defecto https://cloud.langfuse.com (UE). EE. UU.: https://us.cloud.langfuse.com. Autoalojado: su URL.
LANGFUSE_BASE_URL=

# --- Evals de calidad del constructor (solo administradores) ---
# Apagados por defecto: gastan crédito real de modelos. Con FORJA_EVALS=1 aparece «Evals de calidad»
# en el menú de las cuentas administradoras. Cada caso corre en un proyecto desechable de una cuenta
# interna (evals@forja.internal): no toca proyectos, datos ni créditos de nadie. Los topes son del
# despliegue; la interfaz solo puede pedir menos.
FORJA_EVALS=
# Lo máximo que gasta una ejecución, en USD (constructor + juez de diseño). Por defecto 5.
FORJA_EVALS_MAX_RUN_USD=
# Lo máximo que gastan todas las ejecuciones juntas en 24 horas, en USD. Por defecto 20.
FORJA_EVALS_MAX_DAILY_USD=
# Casos construyéndose a la vez (cada uno es un turno completo más un Chromium). Por defecto 2, máximo 4.
FORJA_EVALS_CONCURRENCY=

# --- GitHub (sincronización de proyectos con repositorios) ---
# Sin nada configurado, cada cuenta conecta GitHub con un token de acceso personal desde el studio.
# Con una OAuth App (callback: <PUBLIC_URL>/api/github/oauth/callback) aparece «Conectar con GitHub».
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Webhook de push (POST <PUBLIC_URL>/api/github/webhook, content type JSON). Sin él, se consulta cada GITHUB_POLL_MS.
GITHUB_WEBHOOK_SECRET=
GITHUB_POLL_MS=60000
# GitHub Enterprise: GITHUB_API_URL=https://host/api/v3 y GITHUB_WEB_URL=https://host

# --- Correo (opcional). Sin SMTP, los correos solo quedan en el registro del proyecto ---
SMTP_URL=
EMAIL_FROM=noreply@forja.local

# --- Pagos (opcional) ---
STRIPE_SECRET_KEY=

# Paquetes npm de las apps generadas (add_dependency). FORJA_NPM=0 los desactiva.
# FORJA_NPM=1
# FORJA_NPM_REGISTRY=https://registry.npmjs.org

# Pruebas en navegador del agente (browser_test). FORJA_BROWSER=0 las desactiva.
# Sin FORJA_CHROMIUM usa el Chromium de Playwright: npx playwright-core install chromium-headless-shell
# FORJA_BROWSER=1
# FORJA_CHROMIUM=C:/Program Files/Google/Chrome/Application/chrome.exe
