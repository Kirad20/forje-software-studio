# Puerto del servidor de la plataforma (studio, API, apps, MCP)
PORT=4100
# Origen público; las apps publicadas viven en <slug>.localhost:PORT
PUBLIC_URL=http://localhost:4100
# Dónde se guardan bases de datos, archivos y caché
DATA_DIR=./data
# Clave para cifrar los secretos de los proyectos (32 bytes hex). Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_KEY=

# --- Modelo del constructor (el agente que escribe las apps) ---
# provider: anthropic | openai (cualquier API compatible con OpenAI: OpenAI, Ollama, OpenRouter...)
BUILDER_PROVIDER=anthropic
BUILDER_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Para provider=openai
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=

# --- IA dentro de las apps (Forja AI) ---
APP_AI_PROVIDER=anthropic
APP_AI_MODEL=claude-haiku-5-5
# Créditos iniciales por cuenta
FREE_CREDITS=3000

# --- Correo (opcional). Sin SMTP, los correos solo quedan en el registro del proyecto ---
SMTP_URL=
EMAIL_FROM=noreply@forja.local

# --- Pagos (opcional) ---
STRIPE_SECRET_KEY=
