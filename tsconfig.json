{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@forja/client": ["./sdk/client/index.ts"]
    }
  },
  "include": ["server", "sdk", "studio/src", "test"],
  "exclude": ["server/modules/builder/infrastructure/skills"]
}
